<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%# "locals" contiene todas las variables que recibe la vista: así no falla si no nos pasan title %>
    <title><%= locals.title ? title + " | " : "" %>Joinup</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
<header>
    <nav>
        <h1>Joinup</h1>
        <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/category">Categorias</a></li>
            <li><a href="/event">Eventos</a></li>
           
            <% if(!userLogin){ %>
                <li><a href="/auth/login">Login</a></li>
            <% }else{ %>
                                
                <!-- Contenedor del usuario con clase para el desplegable -->
                <li class="user-menu">
                    <span class="user-info">
                        👤 <%= userLogin.userName %> (<%= userLogin.userRole %>) ▾
                    </span>
                    
                    <!-- Submenú anidado -->
                    <ul class="dropdown">
                        <% if(userLogin.userRole === 'admin'){ %>
                            <li><a href="/registration">Inscripciones</a></li>
                            <li><a href="/user">Usuarios</a></li>
                        <% } else { %>
                            <li><a href="/registration">Mis inscripciones</a></li>
                            <li><a href="/user/<%= userLogin.userId %>">Usuario</a></li>
                        <% } %>
                        <li><a href="/auth/logout">Logout</a></li>
                    </ul>
                </li>
                
            <%}%>
        </ul>
    </nav>
</header>

