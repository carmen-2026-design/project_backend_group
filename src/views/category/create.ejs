<%- include('../layout/header', { title: 'Categoria' }); -%>

<h2>Nueva categoria</h2>
<%- include('../layout/error') -%>

<% if(query ){
    if(query.error){
        %>
        <p class="error"><%= query.error %></p>
        <%
    }
    if(query.message){
        %>
        <p class="message"><%= query.message %></p>
        <%
    }
}
%>


<form action="/category" method="post">
    <label for="categoryName">Nombre de la categoria</label>
    <input type="text" name="categoryName" id="categoryName">
    <label for="categoryDescription">Descripción</label>
    <input type="text" id="categoryDescription" name="categoryDescription">


    <button>Crear</button>
</form>
<%- include('../layout/footer'); -%>