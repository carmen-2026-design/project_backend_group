<article class="category-card">
    <h3><%= category.categoryName %></h3>
    <p>ID: <%= category.categoryId %></p>
    <p>Descripción: <%= category.categoryDescription %></p>
    <a href="/category/<%=category.categoryId%>">Visitar</a>
    
    <form method="get" action="/category/<%=category.categoryId%>/edit">
        <button>Editar</button>
    </form>


    <form method="post" action="/category/<%=category.categoryId%>/delete">
        <button>Eliminar</button>
    </form>

</article>