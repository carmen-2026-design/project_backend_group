<article class="hero-card">
    <h3><%= hero.name %></h3>
    <p>Descripción: <%= hero.description %></p>
    <p>Nivel de utilidad: <%= hero.utility_level %></p>
    <a href="/hero/<%=hero.id%>">Visitar</a>
    <form method="post" action="/hero/<%=hero.id%>/delete">
        <button>Eliminar</button>
    </form>

</article>