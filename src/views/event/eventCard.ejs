<%
    // Formatea la fecha como dd/mm/aaaa hh:mm
    const d = event.eventDate ? new Date(event.eventDate) : null;
    const fecha = (!d || isNaN(d)) ? (event.eventDate || "") :
        String(d.getUTCDate()).padStart(2, '0') + '/' +
        String(d.getUTCMonth() + 1).padStart(2, '0') + '/' +
        d.getUTCFullYear() + ' ' +
        String(d.getUTCHours()).padStart(2, '0') + ':' +
        String(d.getUTCMinutes()).padStart(2, '0');
%>
<article class="event-card">
    <h3><%= event.eventTitle %></h3>
    <p>Descripcion: <%= event.eventDescription %></p>
    <p>Fecha: <%= fecha %></p>
    <p>Direccion: <%= event.eventAddress %></p>
    <p>Código Postal: <%= event.eventPostalCode %></p>
    <p>Provincia: <%= event.province ? event.province.provinceName : event.provinceId %></p>
    <p>Categoria: <%= event.category ? event.category.categoryName : event.categoryId %></p>


    <a href="/event/<%=event.eventId%>">Visitar</a>
    <% if (locals.userLogin && userLogin.userRole === 'admin') { %>

        <form method="get" action="/event/<%=event.eventId%>/edit">
            <button>Editar</button>
        </form>

        <form method="post" action="/event/<%=event.eventId%>/delete">
            <button>Eliminar</button>
        </form>

    <% } else if (locals.userLogin && userLogin.userRole === 'user') { %>
        <%# Inscribirse: hace la petición en segundo plano y no cambia la pantalla %>

      <form method="post" action="/registration">
        <input type="hidden" name="eventId" value="<%= event.eventId %>">
        <input type="hidden" name="registrationPeople" value="1">
        <button>Inscribirse</button>
    </form>
    <% } %>

</article>