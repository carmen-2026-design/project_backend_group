<%- include('../layout/header', { title: 'Usuario' }); -%>

<h2>Lista de usuarios</h2>
<%- include('../layout/error') -%>

<% if(query ){
    if(query.error){
        %>
        <p class="error"><%= query.error %></p>
        <%
    }
    if(query.message){
        %>
        <p class="message"><%= query.message %></p>
        <%
    }
}
%>

<% for (user of users) {%>
    <%- include('userCard',{user}) -%>
<% } %>
<%- include('../layout/footer'); -%>