<%- include('../layout/header', { title: 'Usuario' }); -%>

<h2>Editar usuario</h2>
<%- include('../layout/error') -%>

<% if(query ){
    if(query.error){
        %>
        <p class="error"><%= query.error %></p>
        <%
    }
    if(query.message){
        %>
        <p class="message"><%= query.message %></p>
        <%
    }
}
%>

<form action="/user/<%= user.userId %>/edit" method="post">

    <label for="userName">Nombre de usuario</label>
    <input type="text" name="userName" id="userName" value="<%= user.userName %>" required>

    <label for="userEmail">Email</label>
    <input type="email" id="userEmail" name="userEmail" value="<%= user.userEmail %>" required>
    
    <label for="userPassword">Contraseña</label>
    <input type="password" name="userPassword" id="password" value="<%= user.userPassword %>" required>

    <label for="userPasswordRepeat">Repetir contraseña</label>
    <input type="password" name="userPasswordRepeat" id="userPasswordRepeat" value="<%= user.userPassword %>" required>
  
    <button>Actualizar</button>
    
    
</form>

<% if (userLogin.userRole === 'admin') { %>
    <a href="/user">Volver</a>
<% } else { %>
    <a href="/user/<%= user.userId %>">Volver</a>
<% } %>

<%- include('../layout/footer'); -%>