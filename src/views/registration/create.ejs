<%- include('../layout/header'); -%>

<h2> Nueva inscripción:</h2>

<form action="/registration" method="post">

    <label for="userId">ID del usuario</label>
    <input type="number" name="userId" id="userId" required>

    <label for="eventId">ID del evento</label>
    <input type="number" name="eventId" id="eventId" required>

    <label for="registrationPeople">Número de personas</label>
    <input type="number" name="registrationPeople" id="registrationPeople" min="1" value="1">

    <label for="registrationStatus">Estado de inscripción</label>
    <select name="registrationStatus" id="registrationStatus">
        <% statuses.forEach(status => { %>
            <option value="<%= status %>"><%= status %></option>
        <% }) %>
    </select>

    <button>Crear</button>

</form>

<%- include('../layout/footer'); -%>
