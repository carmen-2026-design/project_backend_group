<%- include('../layout/header'); -%>

<h2> Nueva inscripción:</h2>

<form action="/registration" method="post">

    <label for="user-id">ID del usuario</label>
    <input type="number" name="user-id" id="user-id" required>

    <label for="event-id">ID del evento</label>
    <input type="number" name="event-id" id="event-id" required>

    <label for="registration-people">Número de personas</label>
    <input type="number" name="registration-people" id="registration-people" min="1" value="1">

    <label for="registration-status">Estado de inscripción</label>
    <select name="registration-status" id="registration-status">
        <% statuses.forEach(status => { %>
            <option value="<%= status %>"><%= status %></option>
        <% }) %>
    </select>

    <button>Crear</button>

</form>

<%- include('../layout/footer'); -%>
